<Page
    x:Class="ToraConHelper.Views.PowerToysPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:system="clr-namespace:System;assembly=mscorlib"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:ToraConHelper.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:viewmodels="clr-namespace:ToraConHelper.ViewModels"
    Title="PowerToysPage"
    d:DataContext="{d:DesignInstance viewmodels:ViewModel}"
    d:DesignHeight="1000"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <Page.Resources>
        <Style
            x:Key="switchTitleTextBlockStyle"
            BasedOn="{StaticResource SubtitleTextBlockStyle}"
            TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style BasedOn="{StaticResource {x:Type TextBlock}}" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style BasedOn="{StaticResource {x:Type ListBox}}" TargetType="ListBox">
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style BasedOn="{StaticResource {x:Type ListBoxItem}}" TargetType="{x:Type ListBoxItem}">
                        <Setter Property="Focusable" Value="False" />
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
        <DataTemplate x:Key="profileTemplate">
            <ui:CardAction Command="{Binding OpenFolderCommand}">
                <StackPanel>
                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}">
                        <Run Text="{Binding DecodedName}" />
                        <Run>(</Run>
                        <Run Text="{Binding Name}" />
                        <Run>)</Run>
                    </TextBlock>
                    <TextBlock Style="{StaticResource BodyTextBlockStyle}">
                        <Run>最終更新：</Run>
                        <Run Text="{Binding LastWriteTime, StringFormat=yyyy年MM月dd日 HH:mm:ss}" />
                    </TextBlock>
                </StackPanel>
            </ui:CardAction>
        </DataTemplate>
        <local:PowerToysNavigationDistanceConverter x:Key="distanceConv" />
        <local:TotalHoursTimeSpanConverter x:Key="tsConv"/>
        <local:RemainingTimeWarningConverter x:Key="remainingTimeWarningConv" />
        <Style x:Key="remainingTimeTextBlockStyle" BasedOn="{StaticResource TitleTextBlockStyle}" TargetType="TextBlock">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}, Converter={StaticResource remainingTimeWarningConv}}"
                             Value="{x:Static local:RemainingTimeWarning.Yellow}">
                    <Setter Property="Foreground" Value="Yellow" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}, Converter={StaticResource remainingTimeWarningConv}}"
                             Value="{x:Static local:RemainingTimeWarning.Red}">
                    <Setter Property="Foreground" Value="Red" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>

    <StackPanel>
        <!--  ETS2  -->
        <ui:CardExpander
            Margin="10"
            DataContext="{Binding Ets2}"
            IsExpanded="False">
            <ui:CardExpander.Header>
                <DockPanel LastChildFill="True">
                    <Button
                        Margin="20,0"
                        Command="{Binding OpenGameCommand}"
                        DockPanel.Dock="Right">
                        <Button.Content>
                            <TextBlock>
                                <Run>ゲーム起動</Run>
                                <ui:SymbolIcon Symbol="Games24" />
                            </TextBlock>
                        </Button.Content>
                    </Button>
                    <Button
                        Margin="0,0"
                        Command="{Binding OpenGameFolderCommand}"
                        DockPanel.Dock="Right">
                        <Button.Content>
                            <TextBlock>
                                <Run>ゲームフォルダ表示</Run>
                                <ui:SymbolIcon Symbol="Share24" />
                            </TextBlock>
                        </Button.Content>
                    </Button>
                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Euro Truck Simulator 2" />
                </DockPanel>
            </ui:CardExpander.Header>
            <StackPanel>
                <ui:Card>
                    <DockPanel LastChildFill="True">
                        <Button
                            Margin="20,0"
                            Command="{Binding OpenGameDataFolderCommand}"
                            DockPanel.Dock="Right">
                            <Button.Content>
                                <TextBlock>
                                    <Run>表示</Run>
                                    <ui:SymbolIcon Symbol="Share24" />
                                </TextBlock>
                            </Button.Content>
                        </Button>
                        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="データ フォルダ" />
                    </DockPanel>
                    <ui:Card.Footer>
                        <StackPanel>
                            <TextBox Text="{Binding GameDataFolder}" />
                            <WrapPanel Margin="0,10" Orientation="Horizontal">
                                <WrapPanel.Resources>
                                    <Style BasedOn="{StaticResource {x:Type Button}}" TargetType="ui:Button">
                                        <Setter Property="Margin" Value="0,5,20,5" />
                                        <Setter Property="Padding" Value="8" />
                                    </Style>
                                </WrapPanel.Resources>
                                <ui:Button Command="{Binding OpenGameLogCommand}">
                                    <Button.Content>
                                        <TextBlock>
                                            <Run Text=" game.log.txt 表示" />
                                            <ui:SymbolIcon Symbol="Share24" />
                                        </TextBlock>
                                    </Button.Content>
                                </ui:Button>
                                <ui:Button Command="{Binding OpenGameConfigCommand}">
                                    <Button.Content>
                                        <TextBlock>
                                            <Run Text="config.cfg 表示" />
                                            <ui:SymbolIcon Symbol="Share24" />
                                        </TextBlock>
                                    </Button.Content>
                                </ui:Button>
                                <ui:Button Command="{Binding OpenModFolderCommand}">
                                    <Button.Content>
                                        <TextBlock>
                                            <Run Text="mod フォルダ表示" />
                                            <ui:SymbolIcon Symbol="Share24" />
                                        </TextBlock>
                                    </Button.Content>
                                </ui:Button>
                            </WrapPanel>
                        </StackPanel>
                    </ui:Card.Footer>
                </ui:Card>
                <ui:Card>
                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="ローカル プロファイル" />
                    <ui:Card.Footer>
                        <ListBox ItemTemplate="{StaticResource profileTemplate}" ItemsSource="{Binding LocalProfiles}" />
                    </ui:Card.Footer>
                </ui:Card>
                <ui:Card>
                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Steam プロファイル" />
                    <ui:Card.Footer>
                        <ListBox ItemTemplate="{StaticResource profileTemplate}" ItemsSource="{Binding SteamProfiles}" />
                    </ui:Card.Footer>
                </ui:Card>
            </StackPanel>
        </ui:CardExpander>

        <!--  ATS  -->
        <ui:CardExpander
            Margin="10"
            DataContext="{Binding Ats}"
            IsExpanded="False">
            <ui:CardExpander.Header>
                <DockPanel LastChildFill="True">
                    <Button
                        Margin="20,0"
                        Command="{Binding OpenGameCommand}"
                        DockPanel.Dock="Right">
                        <Button.Content>
                            <TextBlock>
                                <Run>ゲーム起動</Run>
                                <ui:SymbolIcon Symbol="Games24" />
                            </TextBlock>
                        </Button.Content>
                    </Button>
                    <Button
                        Margin="0,0"
                        Command="{Binding OpenGameFolderCommand}"
                        DockPanel.Dock="Right">
                        <Button.Content>
                            <TextBlock>
                                <Run>ゲームフォルダ表示</Run>
                                <ui:SymbolIcon Symbol="Share24" />
                            </TextBlock>
                        </Button.Content>
                    </Button>
                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="American Truck Simulator" />
                </DockPanel>
            </ui:CardExpander.Header>
            <StackPanel>
                <ui:Card>
                    <DockPanel LastChildFill="True">
                        <Button
                            Margin="20,0"
                            Command="{Binding OpenGameDataFolderCommand}"
                            DockPanel.Dock="Right">
                            <Button.Content>
                                <TextBlock>
                                    <Run>表示</Run>
                                    <ui:SymbolIcon Symbol="Share24" />
                                </TextBlock>
                            </Button.Content>
                        </Button>
                        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="データ フォルダ" />
                    </DockPanel>
                    <ui:Card.Footer>
                        <StackPanel>
                            <TextBox Text="{Binding GameDataFolder}" />
                            <WrapPanel Margin="0,10" Orientation="Horizontal">
                                <WrapPanel.Resources>
                                    <Style BasedOn="{StaticResource {x:Type Button}}" TargetType="ui:Button">
                                        <Setter Property="Margin" Value="0,0,20,0" />
                                        <Setter Property="Padding" Value="10" />
                                    </Style>
                                </WrapPanel.Resources>
                                <ui:Button Command="{Binding OpenGameLogCommand}">
                                    <Button.Content>
                                        <TextBlock>
                                            <Run Text=" game.log.txt 表示" />
                                            <ui:SymbolIcon Symbol="Share24" />
                                        </TextBlock>
                                    </Button.Content>
                                </ui:Button>
                                <ui:Button Command="{Binding OpenGameConfigCommand}">
                                    <Button.Content>
                                        <TextBlock>
                                            <Run Text="config.cfg 表示" />
                                            <ui:SymbolIcon Symbol="Share24" />
                                        </TextBlock>
                                    </Button.Content>
                                </ui:Button>
                                <ui:Button Command="{Binding OpenModFolderCommand}">
                                    <Button.Content>
                                        <TextBlock>
                                            <Run Text="mod フォルダ表示" />
                                            <ui:SymbolIcon Symbol="Share24" />
                                        </TextBlock>
                                    </Button.Content>
                                </ui:Button>
                            </WrapPanel>
                        </StackPanel>
                    </ui:Card.Footer>
                </ui:Card>
                <ui:Card>
                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="ローカル プロファイル" />
                    <ui:Card.Footer>
                        <ListBox ItemTemplate="{StaticResource profileTemplate}" ItemsSource="{Binding LocalProfiles}" />
                    </ui:Card.Footer>
                </ui:Card>
                <ui:Card>
                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Steam プロファイル" />
                    <ui:Card.Footer>
                        <ListBox ItemTemplate="{StaticResource profileTemplate}" ItemsSource="{Binding SteamProfiles}" />
                    </ui:Card.Footer>
                </ui:Card>
            </StackPanel>
        </ui:CardExpander>

        <ui:CardExpander
            Margin="10"
            IsExpanded="{Binding IsInfoExpanded, Mode=TwoWay}">
            <ui:CardExpander.Header>
                <DockPanel LastChildFill="True">
                    <TextBlock 
                            Style="{StaticResource TitleTextBlockStyle}" 
                            Margin="20,0"
                            DockPanel.Dock="Right" x:Name="realTimeTitleText"/>
                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Info" />
                </DockPanel>
            </ui:CardExpander.Header>
            <StackPanel>
                <ui:Card>
                    <DockPanel LastChildFill="True">
                        <TextBlock 
                            Style="{StaticResource TitleTextBlockStyle}" 
                            Margin="20,0"
                            DockPanel.Dock="Right"
                            Text="{Binding Path=TruckName}"/>
                        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="車両" />
                    </DockPanel>
                    <ui:Card.Footer>
                        <Grid>
                            <!-- Truck Job Info -->
                            <StackPanel>
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsBusJob}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <ui:Card>
                                    <DockPanel LastChildFill="True">
                                        <TextBlock 
                                        Style="{StaticResource TitleTextBlockStyle}" 
                                        Margin="20,0"
                                        DockPanel.Dock="Right">
                                            <TextBlock.Text>
                                                <MultiBinding Converter="{StaticResource distanceConv}">
                                                    <Binding Path="NavigationDistance"/>
                                                    <Binding Path="GameName"/>
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="移動距離" />
                                    </DockPanel>
                                </ui:Card>
                                <ui:Card>
                                    <DockPanel LastChildFill="True">
                                        <TextBlock 
                                                Style="{StaticResource TitleTextBlockStyle}" 
                                                Margin="20,0"
                                                DockPanel.Dock="Right"
                                                Text="{Binding Path=NavigationTime, Converter={StaticResource tsConv}}"/>
                                        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="所要時間" />
                                    </DockPanel>
                                </ui:Card>
                                <ui:Card>
                                    <DockPanel LastChildFill="True">
                                        <TextBlock 
                                        Style="{StaticResource TitleTextBlockStyle}" 
                                        Margin="20,0"
                                        DockPanel.Dock="Right"
                                        TextWrapping="WrapWithOverflow"
                                        Text="{Binding Path=CargoName}"/>
                                        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="荷物" />
                                    </DockPanel>
                                </ui:Card>
                                <ui:Card>
                                    <DockPanel LastChildFill="True">
                                        <TextBlock 
                                        Style="{StaticResource remainingTimeTextBlockStyle}" 
                                        Margin="20,0"
                                        DockPanel.Dock="Right"
                                        Tag="{Binding Path=NextRestStopTime}"
                                        Text="{Binding Path=NextRestStopTime, Converter={StaticResource tsConv}}"/>
                                        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="休息まで" />
                                    </DockPanel>
                                </ui:Card>
                                <ui:Card>
                                    <DockPanel LastChildFill="True">
                                        <TextBlock 
                                        Style="{StaticResource remainingTimeTextBlockStyle}" 
                                        Margin="20,0"
                                        DockPanel.Dock="Right"
                                        Tag="{Binding Path=NextMandatoryBreakTime}"
                                        Text="{Binding Path=NextMandatoryBreakTime, Converter={StaticResource tsConv}}"/>
                                        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="法定休憩まで" />
                                    </DockPanel>
                                </ui:Card>
                                <ui:Card>
                                    <DockPanel LastChildFill="True">
                                        <TextBlock
                                        Style="{StaticResource TitleTextBlockStyle}"
                                        Margin="20,0"
                                        DockPanel.Dock="Right"
                                        Text="{Binding GameTime, StringFormat={}{0:HH:mm}}" />
                                        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="ゲーム内時間" />
                                    </DockPanel>
                                </ui:Card>
                            </StackPanel>

                            <!-- Bus Job Info -->
                            <StackPanel>
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsBusJob}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <ui:Card>
                                    <DockPanel LastChildFill="True">
                                        <TextBlock
                                        Margin="20,0"
                                        DockPanel.Dock="Right"
                                        Style="{StaticResource TitleTextBlockStyle}"
                                        Text="{Binding BusJobCurrentStage}" />
                                        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="停留所" />
                                    </DockPanel>
                                </ui:Card>
                                <ui:Card>
                                    <DockPanel LastChildFill="True">
                                        <TextBlock
                                        Style="{StaticResource TitleTextBlockStyle}"
                                        Margin="20,0"
                                        DockPanel.Dock="Right">
                                            <TextBlock.Text>
                                                <MultiBinding Converter="{StaticResource distanceConv}">
                                                    <Binding Path="NavigationDistance" />
                                                    <Binding Path="GameName" />
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="移動距離" />
                                    </DockPanel>
                                </ui:Card>
                                <ui:Card>
                                    <DockPanel LastChildFill="True">
                                        <TextBlock
                                        Style="{StaticResource TitleTextBlockStyle}"
                                        Margin="20,0"
                                        DockPanel.Dock="Right"
                                        Text="{Binding BusJobAverageSatisfaction, StringFormat={}{0:P0}}" />
                                        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="満足度" />
                                    </DockPanel>
                                </ui:Card>
                                <ui:Card>
                                    <ui:Card.Style>
                                        <Style TargetType="ui:Card">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding BusJobStages.Count}" Value="0">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ui:Card.Style>
                                    <ItemsControl ItemsSource="{Binding BusJobStages}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border
                                                Margin="2,4"
                                                Padding="8"
                                                BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}"
                                                BorderThickness="1"
                                                CornerRadius="4">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock
                                                        VerticalAlignment="Center"
                                                        FontSize="20"
                                                        Style="{StaticResource BodyStrongTextBlockStyle}">
                                                        <Run Text="{Binding SourceName, Mode=OneWay}" />
                                                        <LineBreak />
                                                        <Run Text=" → " />
                                                        <Run Text="{Binding DestinationName, Mode=OneWay}" />
                                                        </TextBlock>
                                                        <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                                            <TextBlock
                                                            HorizontalAlignment="Right"
                                                            FontSize="20">
                                                                <TextBlock.Style>
                                                                    <Style BasedOn="{StaticResource BodyTextBlockStyle}" TargetType="TextBlock">
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding TimeUntilPlannedArrival}" Value="{x:Null}">
                                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                                <Run Foreground="White" Text="残り時間 : " />
                                                                <Run Text="{Binding TimeUntilPlannedArrival, Mode=OneWay}">
                                                                    <Run.Style>
                                                                        <Style TargetType="Run">
                                                                            <Setter Property="Foreground" Value="Green" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsPastPlannedArrival}" Value="True">
                                                                                    <Setter Property="Foreground" Value="Red" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Run.Style>
                                                                </Run>
                                                            </TextBlock>
                                                            <TextBlock
                                                            HorizontalAlignment="Right"
                                                            FontSize="20"
                                                            Style="{StaticResource BodyTextBlockStyle}">
                                                                <Run Text="到着予定 : " />
                                                                <Run Text="{Binding PlannedArrivalTime, Mode=OneWay}" />
                                                            </TextBlock>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ui:Card>
                                <ui:Card>
                                    <DockPanel LastChildFill="True">
                                        <TextBlock
                                        Margin="20,0"
                                        DockPanel.Dock="Right"
                                        Style="{StaticResource TitleTextBlockStyle}"
                                        Text="{Binding GameTime, StringFormat={}{0:HH:mm}}" />
                                        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="ゲーム内時間" />
                                    </DockPanel>
                                </ui:Card>
                            </StackPanel>
                        </Grid>
                    </ui:Card.Footer>
                </ui:Card>
            </StackPanel>
        </ui:CardExpander>
    </StackPanel>
</Page>
